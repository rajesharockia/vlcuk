---
/**
 * A row of video cards below the photo carousel — the same structural slot
 * IPL's homepage gives its "Match Highlights" row, reworked in this site's
 * own palette. Cards are real content-collection entries (see
 * src/content.config.ts and public/admin/config.yml's `videos` collection),
 * not hardcoded placeholders, so an editor can add a real one later through
 * the same /admin flow as everything else on the site.
 *
 * No entries yet? The section still renders, with a bilingual "coming soon"
 * notice — the brief was to have the section in place, ready for videos to
 * be attached later, not to invent placeholder video content.
 */
import { getCollection } from 'astro:content';

import Bilingual from './Bilingual.astro';
import SectionHeading from './SectionHeading.astro';
import VideoCard from './cards/VideoCard.astro';
import { byNewest } from '../lib/content';

const videos = byNewest(await getCollection('videos')).slice(0, 8);
---

<div class="mx-auto max-w-6xl px-5 sm:px-8">
  <section class="py-12 sm:py-16">
    <SectionHeading k="home.videos" href="/videos/" />

    {
      videos.length === 0 ? (
        <p class="text-[color:var(--color-ink-faint)]">
          <Bilingual k="videos.empty" />
        </p>
      ) : (
        <div class="video-carousel" data-video-carousel>
          {/*
            Same left/right arrow pattern as the photo carousel above, but a
            single scrollable row rather than one full-bleed slide at a time
            — video thumbnails are small enough that several sit side by
            side, so "next" means "scroll along," not "replace." Arrows are
            an enhancement: without JS the row is still natively scrollable
            by touch, trackpad, or drag, and the script hides an arrow
            entirely once there's nothing left in that direction to reach.
          */}
          <button
            type="button"
            class="video-carousel__arrow video-carousel__arrow--prev"
            data-video-prev
            aria-label="Previous videos"
            hidden
          >
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
              <path d="M11 4l-5 5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="video-row" data-video-track>
            {videos.map((entry) => (
              <div class="video-row__item">
                <VideoCard entry={entry} />
              </div>
            ))}
          </div>

          <button
            type="button"
            class="video-carousel__arrow video-carousel__arrow--next"
            data-video-next
            aria-label="Next videos"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
              <path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      )
    }
  </section>
</div>

<style>
  .video-carousel {
    position: relative;
    /* Room for the arrow buttons to sit just outside the row itself. */
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
  }

  .video-row {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    padding-block: 0.25rem;
    /* Hide the scrollbar itself — the arrows and native touch/trackpad
       scrolling are the intended ways to move through the row, a visible
       scrollbar here would just be visual noise. */
    scrollbar-width: none;
  }

  .video-row::-webkit-scrollbar {
    display: none;
  }

  .video-row__item {
    flex: 0 0 auto;
    width: 12rem;
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .video-row__item {
      width: 14.5rem;
    }
  }

  @media (min-width: 64rem) {
    .video-row__item {
      width: 16rem;
    }
  }

  .video-carousel__arrow {
    position: absolute;
    top: 40%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: -1.25rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(31 27 22 / 0.12);
    transition: border-color 150ms ease, color 150ms ease;
  }

  .video-carousel__arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .video-carousel__arrow[hidden] {
    display: none;
  }

  .video-carousel__arrow--prev {
    left: -0.5rem;
  }

  .video-carousel__arrow--next {
    right: -0.5rem;
  }

  @media (min-width: 40rem) {
    .video-carousel__arrow--prev {
      left: -1.25rem;
    }
    .video-carousel__arrow--next {
      right: -1.25rem;
    }
  }

</style>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-video-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-video-track]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-video-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-video-next]');
    if (!track || !prevBtn || !nextBtn) continue;

    // Scrolls by roughly one screenful of cards, same "page at a time" feel
    // as the photo carousel's slide-to-slide steps.
    function scrollByPage(direction: 1 | -1) {
      track!.scrollBy({ left: direction * track!.clientWidth * 0.9, behavior: 'smooth' });
    }

    prevBtn.addEventListener('click', () => scrollByPage(-1));
    nextBtn.addEventListener('click', () => scrollByPage(1));

    // An arrow is only shown while there's actually somewhere left to go in
    // that direction — no point offering a "previous" button at the start
    // of the row, or a "next" one once everything is already in view.
    function updateArrows() {
      const maxScroll = track!.scrollWidth - track!.clientWidth;
      prevBtn!.hidden = track!.scrollLeft <= 4;
      nextBtn!.hidden = maxScroll <= 4 || track!.scrollLeft >= maxScroll - 4;
    }

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  }
</script>
