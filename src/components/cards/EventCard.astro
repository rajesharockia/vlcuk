---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Bilingual from '../Bilingual.astro';
import EntryDate from '../EntryDate.astro';
import { resolveImage } from '../../lib/images';

interface Props {
  entry: CollectionEntry<'events'>;
  /** Full-width treatment used for the featured event. */
  feature?: boolean;
}

const { entry, feature = false } = Astro.props;
const { title_en, title_ta, summary_en, summary_ta, venue_en, venue_ta, date, end_date, image } =
  entry.data;
const cover = resolveImage(image);
const href = `/events/${entry.id}/`;
---

{
  feature ? (
    <article class="border border-[color:var(--color-rule-strong)] bg-[color:var(--color-paper-deep)] p-7 sm:p-11">
      <p class="eyebrow text-[color:var(--color-accent)]">
        <Bilingual k="events.featured" />
      </p>

      <h3 class="mt-4 max-w-[20ch] text-[1.8rem] leading-tight font-medium sm:text-[2.5rem]">
        <a href={href} class="link-title">
          <Bilingual en={title_en} ta={title_ta} />
        </a>
      </h3>

      <div class="mt-5 flex flex-wrap items-baseline gap-x-8 gap-y-2 text-[0.95rem] text-[color:var(--color-ink-muted)]">
        <EntryDate date={date} end={end_date} />
        {(venue_en || venue_ta) && (
          <span>
            <Bilingual en={venue_en} ta={venue_ta} />
          </span>
        )}
      </div>

      {(summary_en || summary_ta) && (
        <p class="mt-5 max-w-[var(--measure)] text-[1.02rem] text-[color:var(--color-ink-muted)]">
          <Bilingual en={summary_en} ta={summary_ta} />
        </p>
      )}

      <a href={href} class="btn btn-primary mt-8 text-[0.8rem]">
        <Bilingual k="common.readMore" />
      </a>

      {cover && (
        <Image
          src={cover}
          alt=""
          widths={[600, 1200]}
          sizes="(min-width: 48rem) 700px, 100vw"
          class="mt-8 h-auto w-full object-cover"
          loading="lazy"
        />
      )}
    </article>
  ) : (
    // Thumbnail on the left, content on the right — the list pattern from
    // Publishers Weekly's events section, reworked in the site's own
    // typographic style rather than a boxed "card" treatment.
    <article class="grid gap-5 border-b border-[color:var(--color-rule)] py-7 sm:grid-cols-[140px_1fr] sm:gap-7">
      <a href={href} class="block" tabindex="-1" aria-hidden="true">
        {cover ? (
          <Image
            src={cover}
            alt=""
            widths={[140, 280]}
            sizes="140px"
            class="aspect-square w-full border border-[color:var(--color-rule)] object-cover"
            loading="lazy"
          />
        ) : (
          // Keeps the left column's width consistent even before an editor
          // has uploaded a photo for this event.
          <div class="flex aspect-square w-full items-center justify-center border border-[color:var(--color-rule)] bg-[color:var(--color-paper-sunk)]">
            <span class="eyebrow px-2 text-center text-[0.6rem]">Vishnupuram</span>
          </div>
        )}
      </a>

      <div class="max-w-[var(--measure)]">
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-[color:var(--color-ink-muted)]">
          <EntryDate date={date} end={end_date} class="eyebrow" />
          {(venue_en || venue_ta) && (
            <span class="text-[0.9rem] text-[color:var(--color-ink-faint)]">
              <Bilingual en={venue_en} ta={venue_ta} />
            </span>
          )}
        </div>

        <h3 class="mt-2 text-[1.2rem] leading-snug font-medium">
          <a href={href} class="link-title">
            <Bilingual en={title_en} ta={title_ta} />
          </a>
        </h3>

        {(summary_en || summary_ta) && (
          <p class="mt-2.5 text-[0.96rem] text-[color:var(--color-ink-muted)]">
            <Bilingual en={summary_en} ta={summary_ta} />
          </p>
        )}

        <a href={href} class="link-accent mt-3 inline-block text-[0.85rem]">
          <Bilingual k="common.readMore" />
          <span aria-hidden="true"> →</span>
        </a>
      </div>
    </article>
  )
}
