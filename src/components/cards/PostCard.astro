---
import type { CollectionEntry } from 'astro:content';
import Bilingual from '../Bilingual.astro';
import EntryDate from '../EntryDate.astro';
import { meaningful } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title_en, title_ta, summary_en, summary_ta, date, author } = entry.data;
const href = `/blog/${entry.id}/`;
const byline = meaningful(author);
---

<article class="border-b border-[color:var(--color-rule)] py-8">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <EntryDate date={date} class="eyebrow" />
    {
      byline && (
        <p class="text-[0.85rem] text-[color:var(--color-ink-faint)]">
          <Bilingual k="blog.author" /> {byline}
        </p>
      )
    }
  </div>

  <h3 class="mt-3 max-w-[var(--measure)] text-[1.25rem] leading-snug font-medium sm:text-[1.4rem]">
    <a href={href} class="link-title">
      <Bilingual en={title_en} ta={title_ta} />
    </a>
  </h3>

  <p class="mt-3 max-w-[var(--measure)] text-[0.98rem] text-[color:var(--color-ink-muted)]">
    <Bilingual en={summary_en} ta={summary_ta} />
  </p>

  <a href={href} class="link-accent mt-4 inline-block text-[0.85rem]">
    <Bilingual k="common.readMore" />
    <span aria-hidden="true"> →</span>
  </a>
</article>
