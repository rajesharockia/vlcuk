---
import SiteLogo from './SiteLogo.astro';
import LanguageToggle from './LanguageToggle.astro';
import SearchBar from './SearchBar.astro';
import Bilingual from './Bilingual.astro';
import { t, type UIKey } from '../i18n/ui';

type NavItem = {
  href: string;
  key: UIKey;
  /** Picks up the accent colour, to keep the Donate link prominent. */
  accent?: boolean;
};

const nav: NavItem[] = [
  { href: '/discussions/', key: 'nav.discussions' },
  { href: '/events/', key: 'nav.events' },
  { href: '/reviews/', key: 'nav.reviews' },
  { href: '/blog/', key: 'nav.blog' },
  { href: '/videos/', key: 'nav.videos' },
  // Donate is deliberately not linked anywhere on the site right now — not
  // needed at the moment. The page itself (src/pages/donate.astro) is still
  // there, untouched, just unlinked, so it's a one-line change to bring back.
  { href: '/contact/', key: 'nav.contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="border-b border-[color:var(--color-rule)]">
  {/*
    One compact row at md+, grouped the way iplt20.com's header is: logo and
    nav links clustered together on the left, with the language toggle and
    (below md) the menu button pushed to the far right — two flex groups with
    space between them, not three items spread evenly across the bar, which
    is what left the nav stranded in the middle rather than beside the logo.
    Below md there isn't room for the nav links on one line at all, so they
    move into a JS-toggled dropdown and only the logo, toggle, and hamburger
    stay in the compact bar.
  */}
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-2 sm:px-8 sm:py-2.5">
    <div class="flex min-w-0 items-center gap-6 lg:gap-10">
      <a href="/" class="min-w-0 shrink-0" aria-label="Vishnupuram UK — home">
        <SiteLogo variant="header" eager />
      </a>

      <nav
        class="hidden min-w-0 md:block"
        aria-label={`${t('nav.primary').en} / ${t('nav.primary').ta}`}
      >
        <ul class="flex items-center gap-5 lg:gap-7">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={['nav-link', item.accent && 'nav-link--accent']}
                >
                  <Bilingual k={item.key} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Search sits right after Contact, the last item in the nav list. */}
      <SearchBar />
    </div>

    <div class="flex shrink-0 items-center gap-3 sm:gap-6">
      <LanguageToggle />

      {/*
        Donate lives in the nav list itself rather than as a second button
        here, so it sits in the requested order beside Contact instead of
        appearing twice in the same header. The prominent button treatment is
        still carried by the footer and by the home page's donate section.
      */}

      <!-- Progressive-enhancement menu button: hidden unless JS runs. -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle md:hidden"
        aria-expanded="false"
        aria-controls="primary-nav-mobile"
      >
        <span class="sr-only">
          <Bilingual k="nav.menu" />
        </span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" fill="none">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile-only dropdown — the inline nav above already covers md+, so this
      is never shown at the same time as that one. */}
  <nav
    id="primary-nav-mobile"
    class="nav-panel border-t border-[color:var(--color-rule)] md:hidden"
    aria-label={`${t('nav.primary').en} / ${t('nav.primary').ta}`}
  >
    <ul class="mx-auto flex max-w-6xl flex-col gap-0 px-5 py-2 sm:px-8">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={['nav-link', item.accent && 'nav-link--accent']}
            >
              <Bilingual k={item.key} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    background: none;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
  }

  .nav-link {
    display: block;
    padding: 0.6rem 0;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-ink-muted);
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link[aria-current='page'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .nav-link--accent {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Mobile: the nav collapses only when JavaScript is available to reopen it.
     Without JS the `is-collapsed` class is never added and the list stays
     visible, so navigation always works. */
  @media (max-width: 47.99rem) {
    .nav-panel.is-collapsed {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('primary-nav-mobile');

  if (toggle && panel) {
    // Collapse only now that we know the toggle can reopen it.
    panel.classList.add('is-collapsed');

    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('is-collapsed');
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }
</script>
