---
import Bilingual from './Bilingual.astro';
import SectionHeading from './SectionHeading.astro';

const teaser = {
  en: 'Vishnupuram UK brings together readers with a shared interest in Tamil literature. Established as the UK chapter in 2026, we are part of a wider literary circle founded in Coimbatore in 2010 by readers and friends of the writer Jeyamohan. Our aim is to encourage attentive reading, thoughtful discussion and wider appreciation of significant literary works and their creators.',
  ta: 'விஷ்ணுபுரம் இலக்கிய வட்டம், கிரேட் பிரிட்டன் (Vishnupuram UK) தமிழ் இலக்கியத்தின் மீது ஆழ்ந்த ஈடுபாடு கொண்ட வாசகர்களை ஒன்றிணைக்கிறது. 2026-ஆம் ஆண்டில் UK கிளையாகத் தொடங்கப்பட்ட இவ்வமைப்பு, எழுத்தாளர் ஜெயமோகன் அவர்களின் வாசகர்கள் மற்றும் நண்பர்களால் 2010-ஆம் ஆண்டு கோவையில் தொடங்கப்பட்ட சர்வதேச விஷ்ணுபுரம் இலக்கிய வட்டத்தின் ஓர் அங்கமாகும்.',
};
---

<div class="mx-auto max-w-6xl px-5 sm:px-8">
  <section class="py-16 sm:py-20">
    <SectionHeading k="home.about" href="/about/" linkKey="common.readMore" />

    <div class="max-w-[var(--measure-wide)] space-y-7 text-[1rem] leading-relaxed text-[color:var(--color-ink-muted)]">
      <p>
        <Bilingual en={teaser.en} ta={teaser.ta} />
      </p>
    </div>
  </section>
</div>

