---
import { Font } from 'astro:assets';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';

interface Props {
  /** Page title, already resolved to plain text. */
  title?: string;
  description?: string;
  /** Set on article pages so the hero spacing can differ from the home page. */
  bodyClass?: string;
}

const TAGLINE = 'To promote art and artists, beyond the boundaries of language';

const {
  title,
  description = TAGLINE,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} — Vishnupuram UK` : `Vishnupuram UK — ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://vishnupuram.uk');
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical.href} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="Vishnupuram UK" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Self-hosted with fallback metrics. See astro.config.mjs.

      Only the English face is preloaded: English is the default language, so
      it is what almost every first paint needs. The Tamil face is still
      emitted and self-hosted, just fetched normally — preloading both would
      put several hundred kilobytes of fonts ahead of everything else, and the
      generated fallback metrics keep the swap from shifting the layout.
    */}
    <Font cssVariable="--font-serif-en" preload />
    <Font cssVariable="--font-serif-ta" />

    {/*
      Applies the saved language before first paint so a reader who chose
      Tamil doesn't see a flash of English on every navigation. Deliberately
      inline and blocking — it is two lines and must run before the body
      renders.
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('vp-lang');
          if (saved === 'ta' || saved === 'en') {
            document.documentElement.dataset.lang = saved;
            document.documentElement.lang = saved;
          }
        } catch (e) {
          /* storage blocked — fall through to the default English */
        }
      })();
    </script>

    {/*
      Netlify Identity is what backs the Decap CMS git-gateway login. This
      snippet completes an invite or password-recovery link that lands on the
      public site by forwarding it to /admin/, where the CMS is mounted.
    */}
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function (user) {
          if (!user) {
            window.netlifyIdentity.on('login', function () {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>
  </head>

  <body class={`flex min-h-screen flex-col bg-paper text-ink ${bodyClass}`}>
    <a href="#main" class="skip-link">
      <span lang="en" data-lang="en">{t('common.skipToContent').en}</span>
      <span lang="ta" data-lang="ta">{t('common.skipToContent').ta}</span>
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--color-ink);
        color: var(--color-paper);
        text-decoration: none;
      }

      .skip-link:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
    </style>
  </body>
</html>
