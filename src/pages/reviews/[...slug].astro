---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleShell from '../../components/ArticleShell.astro';
import Bilingual from '../../components/Bilingual.astro';
import EntryDate from '../../components/EntryDate.astro';
import { resolveImage } from '../../lib/images';
import { pair, pairText, meaningful } from '../../lib/content';

// `satisfies` rather than a type annotation, so the entry type survives into
// Astro.props instead of widening to `unknown`.
export const getStaticPaths = (async () => {
  const entries = await getCollection('reviews');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { Content } = await render(entry);

const {
  title_en,
  title_ta,
  book_title_en,
  book_title_ta,
  author,
  translator,
  reviewer,
  date,
  cover_image,
  source_name,
  source_url,
} = entry.data;

const cover = resolveImage(cover_image);
const title = pairText(pair(title_en, title_ta));

// An em dash or "n/a" in these fields means "does not apply" — omit the row
// rather than printing a stray dash.
const translatorName = meaningful(translator);
const reviewerName = meaningful(reviewer);
const hasBookTitle = Boolean(book_title_en || book_title_ta);
---

<BaseLayout title={title}>
  <ArticleShell title_en={title_en} title_ta={title_ta} backHref="/reviews/" backKey="nav.reviews">
    <EntryDate slot="eyebrow" date={date} class="eyebrow block" />

    <Fragment slot="meta">
      {
        hasBookTitle && (
          <p class="mt-4 text-[1.2rem] italic text-[color:var(--color-ink-muted)]">
            <Bilingual en={book_title_en} ta={book_title_ta} />
          </p>
        )
      }

      {
        source_name && (
          <p class="mt-4 border-l-2 border-[color:var(--color-accent)] py-1 pl-4 text-[0.92rem] text-[color:var(--color-ink-muted)]">
            <Bilingual k="review.originallyPublished" /> <strong>{source_name}</strong>.{' '}
            {source_url && (
              <a href={source_url} class="link-accent" target="_blank" rel="noopener noreferrer">
                <Bilingual k="review.readFull" />
                <span aria-hidden="true"> ↗</span>
              </a>
            )}
          </p>
        )
      }
    </Fragment>

    <Fragment slot="lede">
      <div class="mt-10 grid gap-8 sm:grid-cols-[180px_1fr] sm:gap-10">
        {
          cover ? (
            <Image
              src={cover}
              alt=""
              widths={[180, 360]}
              sizes="180px"
              class="aspect-2/3 w-full border border-[color:var(--color-rule)] object-cover"
              loading="lazy"
            />
          ) : (
            <div class="flex aspect-2/3 w-full items-center justify-center border border-[color:var(--color-rule)] bg-[color:var(--color-paper-sunk)]">
              <span class="eyebrow px-2 text-center text-[0.6rem]">Vishnupuram</span>
            </div>
          )
        }

        <dl class="space-y-4 self-start text-[0.95rem]">
          <div>
            <dt class="eyebrow"><Bilingual k="review.author" /></dt>
            <dd class="mt-1">{author}</dd>
          </div>

          {
            translatorName && (
              <div>
                <dt class="eyebrow">
                  <Bilingual k="review.translator" />
                </dt>
                <dd class="mt-1">{translatorName}</dd>
              </div>
            )
          }

          {
            reviewerName && (
              <div>
                <dt class="eyebrow">
                  <Bilingual k="review.reviewer" />
                </dt>
                <dd class="mt-1">{reviewerName}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </Fragment>

    <Content />
  </ArticleShell>
</BaseLayout>
