---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bilingual from '../components/Bilingual.astro';
import { t } from '../i18n/ui';

import drArutchelvamImg from '../assets/images/dr-arutchelvam-vijayaraman.png';
import aravindanImg from '../assets/images/aravindan-govindarajan.png';
import deepaImg from '../assets/images/deepa-krishnamachari.png';

const intro = {
  en: 'Vishnupuram UK, formally the Vishnupuram Literary Circle, Great Britain, brings together readers with a shared interest in Tamil literature. Established as the UK chapter in 2026, we are part of a wider literary circle founded in Coimbatore in 2010 by readers and friends of the writer Jeyamohan. Our aim is to encourage attentive reading, thoughtful discussion and wider appreciation of significant literary works and their creators.',
  ta: 'விஷ்ணுபுரம் இலக்கிய வட்டம், கிரேட் பிரிட்டன் (Vishnupuram UK) தமிழ் இலக்கியத்தின் மீது ஆழ்ந்த ஈடுபாடு கொண்ட வாசகர்களை ஒன்றிணைக்கிறது. 2026-ஆம் ஆண்டில் UK கிளையாகத் தொடங்கப்பட்ட இவ்வமைப்பு, எழுத்தாளர் ஜெயமோகன் அவர்களின் வாசகர்கள் மற்றும் நண்பர்களால் 2010-ஆம் ஆண்டு கோவையில் தொடங்கப்பட்ட சர்வதேச விஷ்ணுபுரம் இலக்கிய வட்டத்தின் ஓர் அங்கமாகும். தீவிரமான வாசிப்பு, ஆழமான உரையாடல்கள் மற்றும் சிறந்த இலக்கியப் படைப்புகளையும் அவற்றின் படைப்பாளிகளையும் பரவலாகக் கொண்டாடுவதே எங்கள் முதன்மை நோக்கமாகும்.',
};

const activitiesLede = {
  en: 'Our activities include:',
  ta: 'எங்கள் முக்கிய செயல்பாடுகள்:',
};

const activities = [
  {
    en: 'Regular reading and short-story discussions on modern and classical Tamil literature.',
    ta: 'நவீன மற்றும் செவ்வியல் தமிழ் இலக்கியங்கள் குறித்த தொடர் வாசிப்பு மற்றும் சிறுகதை உரையாடல்கள்.',
  },
  {
    en: 'Conversations with writers and translators, lectures, and literary meetups.',
    ta: 'எழுத்தாளர்கள், மொழிபெயர்ப்பாளர்களுடனான நேரடி உரையாடல்கள், சொற்பொழிவுகள் மற்றும் இலக்கியச் சந்திப்புகள்.',
  },
  {
    en: 'Organising practical workshops on literature, philosophy, and creative writing.',
    ta: 'இலக்கியம், தத்துவம் மற்றும் புனைகதை எழுத்து தொடர்பான பயிலரங்குகளை ஏற்பாடு செய்தல்.',
  },
  {
    en: 'Introducing new readers to the richness of modern Tamil literature.',
    ta: 'தரமான நவீன தமிழ் இலக்கியப் படைப்புகளைப் புதிய வாசகர்களுக்கு அறிமுகப்படுத்துதல்.',
  },
  {
    en: 'Collaborating actively with Vishnupuram chapters in India, the United States, and Europe.',
    ta: 'இந்தியா, அமெரிக்கா மற்றும் ஐரோப்பாவில் உள்ள விஷ்ணுபுரம் கிளைகளுடன் இணைந்து செயல்படுதல்.',
  },
];

const unifiedWisdom = {
  en: 'Through Unified Wisdom (Muzhumaiyarivu) classes in the UK, we also create opportunities to explore subjects such as Indian and Western philosophy, creative writing, and a host of other topics supported by Unified Wisdom activities in India. These events bring people together not only to learn, but to question, exchange perspectives and develop a deeper engagement with literature and culture.',
  ta: 'UK-வில் நடைபெறும் "முழுமையறிவு" (Unified Wisdom) வகுப்புகளின் வழியாக, இந்திய மற்றும் மேற்கத்திய தத்துவம், புனைகதை எழுத்து உள்ளிட்ட பல்வேறு தளங்களை ஆராய்வதற்கான வாய்ப்புகளையும் உருவாக்குகிறோம். வாசகர்கள் வெறுமனே கற்றுக்கொள்வதோடு மட்டுமல்லாமல், கேள்விகளை எழுப்பவும், புதிய பார்வைகளை விவாதிக்கவும், இலக்கியம் மற்றும் பண்பாட்டுடன் ஆழமான பிணைப்பை ஏற்படுத்தவும் இவை களம் அமைக்கின்றன.',
};

const welcomeNote = {
  en: 'We welcome established readers and those beginning to explore Tamil literature. By connecting readers across the UK and with the wider Vishnupuram community, we hope to make literature a continuing conversation that reaches beyond boundaries of language and place.',
  ta: 'தமிழ் இலக்கியத்தை வாசிக்கத் தொடங்குவோர் மற்றும் நீண்டகால வாசகர்கள் என அனைவரும் இதில் இணையலாம். UK முழுவதும் உள்ள வாசகர்களை ஒன்றிணைத்து, மொழி மற்றும் நில எல்லைகளைக் கடந்து இலக்கியத்தைத் தொடர் உரையாடலாக முன்னெடுப்பதே எங்கள் நோக்கம்.',
};

const teamIntro = {
  en: 'Vishnupuram UK is run by a team of volunteers led by the people below. Together, they organise our literary events, reading discussions and Unified Wisdom classes and help build a welcoming community for readers across the UK. They are also engaged in supporting the activities of Living Tamil organisation headquartered in India (www.livingtamil.org).',
  ta: 'விஷ்ணுபுரம் UK வாசகர்களின் தன்னார்வக் குழுவால் முன்னெடுக்கப்படுகிறது. இலக்கிய நிகழ்வுகள், வாசிப்பு உரையாடல்கள், முழுமையறிவு வகுப்புகள் ஆகியவற்றை ஒருங்கிணைத்து UK முழுவதும் வாசகர்களுக்கான அமைப்பை உருவாக்குவதில் இவர்கள் பங்காற்றுகிறார்கள். மேலும், இந்தியாவில் இயங்கும் சர்வதேச "லிவிங் தமிழ்" அமைப்பின் (www.livingtamil.org) செயல்பாடுகளிலும் இவர்கள் உறுதுணையாகப் பணியாற்றுகின்றனர்.',
};

const teamMembers = [
  {
    name_en: 'Dr. Arutchelvam Vijayaraman',
    name_ta: 'மருத்துவர் அருட்செல்வம் விஜயராமன்',
    role_en: 'Consultant Physician · Lead, Vishnupuram UK',
    role_ta: 'மூத்த ஆலோசகர் மருத்துவர் · ஒருங்கிணைப்பாளர், விஷ்ணுபுரம் UK',
    tags_en: ['Consultant Physician', 'NHS (27 Years)', 'LitFest 2027 Organiser'],
    tags_ta: ['மூத்த மருத்துவர்', 'NHS (27 ஆண்டுகள்)', 'லிட்பெஸ்ட் 2027'],
    image: drArutchelvamImg,
    bio_en:
      "Dr Arutchelvam Vijayaraman is a consultant specialising in endocrinology, diabetes, obesity and metabolism. He has worked full-time in the United Kingdom's National Health Service for 27 years. His interests include longevity and regenerative medicine, with a focus on evidence for innovative therapies in healthy ageing, cellular reprogramming and disease prevention. He has a deep interest in literature, particularly the work of Jeyamohan, and leads Vishnupuram Literary Circle UK.",
    bio_ta:
      'மருத்துவர் அருட்செல்வம் விஜயராமன் நாளமில்லாச் சுரப்பியல் (Endocrinology), நீரிழிவு, உடல் பருமன் மற்றும் வளர்சிதை மாற்ற மருத்துவத்தில் நிபுணத்துவம் பெற்ற மூத்த ஆலோசகர் மருத்துவர் ஆவார். இவர் ஐக்கிய இராச்சியத்தின் தேசிய சுகாதார சேவையில் (NHS) 27 ஆண்டுகளாக முழுநேர மருத்துவராகப் பணியாற்றி வருகிறார். ஆரோக்கியமான முதுமை அடைதல், செல்களின் மறுசீரமைப்பு, நோய் தடுப்பு மற்றும் மீளுருவாக்க மருத்துவம் ஆகியவற்றில் ஆழ்ந்த ஈடுபாடு கொண்டவர். தமிழ் இலக்கியத்திலும், குறிப்பாக எழுத்தாளர் ஜெயமோகனின் படைப்புகளிலும் பேரார்வம் கொண்ட இவர், விஷ்ணுபுரம் இலக்கிய வட்டம் UK-வை ஒருங்கிணைத்து வழிநடத்துகிறார்.',
  },
  {
    name_en: 'Mr. Aravindan Govindarajan',
    name_ta: 'அரவிந்தன் கோவிந்தராஜன்',
    role_en: 'Chartered Accountant & Software CFO · London',
    role_ta: 'பட்டயக் கணக்காளர் & தலைமை நிதி அதிகாரி · லண்டன்',
    tags_en: ['Chartered Accountant', 'Software CFO', 'LitFest 2027 Organiser'],
    tags_ta: ['பட்டயக் கணக்காளர்', 'தலைமை நிதி அதிகாரி', 'லிட்பெஸ்ட் 2027'],
    image: aravindanImg,
    bio_en:
      'Aravindan Govindarajan is a London-based Chartered Accountant and software-company CFO with earlier experience as a Big Four auditor. Originally from Madurai, he has lived in the United Kingdom for more than two decades while maintaining a strong commitment to Tamil literature. A lifelong reader, he has followed the work of Jeyamohan since 2007 and supports literary initiatives in the United Kingdom, including Vishnupuram Literary Circle events and Unified Wisdom classes. After taking part in Living Tamil Litfest 2026 in New York, he is now involved in organising Litfest London 2027.',
    bio_ta:
      "அரவிந்தன் கோவிந்தராஜன் லண்டனில் இயங்கும் முன்னணி மென்பொருள் நிறுவனத்தின் தலைமை நிதி அதிகாரியாகவும் (CFO), பட்டயக் கணக்காளராகவும் (Chartered Accountant) பணியாற்றி வருகிறார்; முன்னதாக 'Big Four' தணிக்கை நிறுவனத்தில் அனுபவம் பெற்றவர். மதுரையைப் பூர்வீகமாகக் கொண்ட இவர், இரண்டு தசாப்தங்களுக்கும் மேலாக UK-வில் வசித்து வருகிறார். தீவிர வாசகரான இவர், 2007 முதல் ஜெயமோகனின் எழுத்துக்களைத் தொடர்ந்து வாசித்து வருகிறார். விஷ்ணுபுரம் UK இலக்கிய நிகழ்வுகள் மற்றும் முழுமையறிவு வகுப்புகளை முன்னெடுத்து வருகிறார். நியூயார்க்கில் நடைபெற்ற 'லிவிங் தமிழ் லிட்பெஸ்ட் 2026'-ல் பங்கேற்ற இவர், தற்போது லண்டன் லிட்பெஸ்ட் 2027 நிகழ்வின் ஒருங்கிணைப்புக் குழுவில் தீவிரமாகப் பங்காற்றி வருகிறார்.",
  },
  {
    name_en: 'Mrs. Deepa Krishnamachari',
    name_ta: 'தீபா கிருஷ்ணமாச்சாரி',
    role_en: 'Director, Global Consultancy · London',
    role_ta: 'இயக்குநர், சர்வதேச ஆலோசனை நிறுவனம் · லண்டன்',
    tags_en: ['Director · Global Consultancy', 'Audit Specialist', 'LitFest 2027 Organiser'],
    tags_ta: ['இயக்குநர்', 'தணிக்கை நிபுணர்', 'லிட்பெஸ்ட் 2027'],
    image: deepaImg,
    bio_en:
      "Deepa Krishnamachari is a Director at a global business consultancy firm, specialising in the audit of financial services companies. Originally from Tiruchirappalli, she has lived in London for over two decades. Deepa is an avid reader of Jeyamohan's works, having been introduced to his writing in 2007 through the novel Ezhaam Ulagam. Since then, she has closely followed the Tamil literary world through websites and publications. Since 2025, Deepa has led the organisation of Vishnupuram Literary Circle events and Unified Wisdom classes in the UK. She attended the New York Living Tamil LitFest 2026 and is a member of the team organising the London Living Tamil LitFest 2027.",
    bio_ta:
      'தீபா கிருஷ்ணமாச்சாரி சர்வதேச வணிக ஆலோசனை நிறுவனம் ஒன்றில் நிதிச் சேவை நிறுவனங்களின் தணிக்கை நிபுணத்துவ இயக்குநராகப் பணியாற்றி வருகிறார். திருச்சிராப்பள்ளியைப் பூர்வீகமாகக் கொண்ட இவர், கடந்த இருபது ஆண்டுகளுக்கும் மேலாக லண்டனில் வாழ்ந்து வருகிறார். 2007-ல் "ஏழாம் உலகம்" நாவல் வழியே அறிமுகமாகி, ஜெயமோகனின் படைப்புகளைத் தொடர்ந்து வாசித்து வருகிறார். 2025 முதல் UK-வில் விஷ்ணுபுரம் இலக்கிய வட்ட நிகழ்வுகள் மற்றும் முழுமையறிவு வகுப்புகளை முன்னின்று ஒருங்கிணைத்து வருகிறார். நியூயார்க் லிவிங் தமிழ் லிட்பெஸ்ட் 2026-ல் பங்கேற்ற இவர், லண்டன் லிட்பெஸ்ட் 2027 ஒருங்கிணைப்புக் குழுவிலும் அங்கம் வகிக்கிறார்.',
  },
];
---

<BaseLayout title={t('about.title').en} description={intro.en}>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <!-- Header Hero -->
    <header class="border-b border-[color:var(--color-rule)] pb-8">
      <p class="eyebrow text-[color:var(--color-accent)]">
        <Bilingual en="Vishnupuram UK" ta="விஷ்ணுபுரம் இலக்கிய வட்டம், UK" />
      </p>
      <h1 class="mt-2 text-[2.2rem] leading-tight font-medium sm:text-[3rem]">
        <Bilingual k="about.title" />
      </h1>
      <p class="mt-5 max-w-[var(--measure-wide)] text-[1.1rem] leading-relaxed text-[color:var(--color-ink-muted)]">
        <Bilingual en={intro.en} ta={intro.ta} />
      </p>
    </header>

    <!-- Narrative & Activities -->
    <section class="py-12 border-b border-[color:var(--color-rule)]">
      <div class="max-w-[var(--measure-wide)] space-y-7 text-[1.02rem] leading-relaxed text-[color:var(--color-ink)]">
        <div>
          <h2 class="text-[1.3rem] font-medium text-[color:var(--color-ink)]">
            <Bilingual en={activitiesLede.en} ta={activitiesLede.ta} />
          </h2>
          <ul class="about-activities-list mt-5 space-y-3.5">
            {
              activities.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="activity-bullet" aria-hidden="true">—</span>
                  <span class="text-[color:var(--color-ink-muted)]">
                    <Bilingual en={item.en} ta={item.ta} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="pt-4 border-t border-[color:var(--color-rule)]">
          <h2 class="text-[1.3rem] font-medium text-[color:var(--color-ink)] mb-3">
            <Bilingual en="Unified Wisdom Classes" ta="முழுமையறிவு வகுப்புகள்" />
          </h2>
          <p class="text-[color:var(--color-ink-muted)]">
            <Bilingual en={unifiedWisdom.en} ta={unifiedWisdom.ta} />
          </p>
        </div>

        <div class="rounded-sm bg-[color:var(--color-paper-deep)] p-5 border border-[color:var(--color-rule-strong)]">
          <p class="text-[0.98rem] italic text-[color:var(--color-ink)]">
            <Bilingual en={welcomeNote.en} ta={welcomeNote.ta} />
          </p>
        </div>
      </div>
    </section>

    <!-- Our Team Section (Living Tamil Roster Style) -->
    <section class="py-16 sm:py-20" id="team">
      <div class="border-b border-[color:var(--color-rule)] pb-6 mb-12">
        <div class="kicker text-[color:var(--color-accent)] eyebrow">
          <Bilingual en="Leadership & Organisation" ta="தலைமை & ஒருங்கிணைப்பு" />
        </div>
        <h2 class="mt-2 text-[2rem] font-medium sm:text-[2.4rem]">
          <Bilingual k="about.team" />
        </h2>
        <p class="mt-4 max-w-[var(--measure-wide)] text-[1.02rem] leading-relaxed text-[color:var(--color-ink-muted)]">
          <Bilingual en={teamIntro.en} ta={teamIntro.ta} />
        </p>
      </div>

      <!-- Team Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        {
          teamMembers.map((member) => (
            <article class="roster-card flex flex-col h-full bg-[color:var(--color-paper)] border border-[color:var(--color-rule-strong)] p-6 sm:p-7 transition-all duration-200 hover:-translate-y-1 hover:border-[color:var(--color-accent)] hover:shadow-lg">
              <!-- Portrait Image Container -->
              <div class="ph mb-5 overflow-hidden rounded border border-[color:var(--color-rule)] bg-[color:var(--color-paper-deep)]">
                <Image
                  src={member.image}
                  alt={member.name_en}
                  widths={[320, 640]}
                  sizes="(min-width: 48rem) 320px, 100vw"
                  class="w-full h-auto object-cover aspect-[4/5] transition-transform duration-300 hover:scale-105"
                  loading="lazy"
                />
              </div>

              <!-- Name -->
              <h3 class="font-serif text-[1.3rem] font-medium leading-snug text-[color:var(--color-ink)]">
                <Bilingual en={member.name_en} ta={member.name_ta} />
              </h3>

              <!-- Role & Location -->
              <div class="role mt-1.5 text-[0.88rem] leading-relaxed text-[color:var(--color-ink-muted)]">
                <Bilingual en={member.role_en} ta={member.role_ta} />
              </div>

              <!-- Badges / Tags -->
              <div class="tags mt-3 mb-4 flex flex-wrap gap-1.5" data-lang="en" lang="en">
                {member.tags_en.map((tag) => (
                  <span class="tag inline-block px-2.5 py-0.5 text-[0.72rem] font-semibold uppercase tracking-wider rounded-full bg-[rgba(183,138,61,0.12)] text-[color:var(--color-accent)] border border-[rgba(183,138,61,0.35)]">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="tags mt-3 mb-4 flex flex-wrap gap-1.5" data-lang="ta" lang="ta">
                {member.tags_ta.map((tag) => (
                  <span class="tag inline-block px-2.5 py-0.5 text-[0.72rem] font-semibold uppercase tracking-wider rounded-full bg-[rgba(183,138,61,0.12)] text-[color:var(--color-accent)] border border-[rgba(183,138,61,0.35)]">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Bio -->
              <div class="bio mt-auto pt-4 border-t border-[color:var(--color-rule)] text-[0.92rem] leading-relaxed text-[color:var(--color-ink-muted)]">
                <p data-lang="en" lang="en">{member.bio_en}</p>
                <p data-lang="ta" lang="ta">{member.bio_ta}</p>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Living Tamil Partner Banner -->
      <div class="mt-14 rounded border border-[color:var(--color-rule-strong)] bg-[color:var(--color-paper-deep)] p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <p class="eyebrow text-[color:var(--color-accent)]">
            <Bilingual en="Global Network" ta="சர்வதேச வலையமைப்பு" />
          </p>
          <h3 class="mt-1 font-serif text-[1.25rem] font-medium text-[color:var(--color-ink)]">
            <Bilingual en="Living Tamil Association for World Literature" ta="வாழும் தமிழ் — உலக இலக்கிய அமைப்பு" />
          </h3>
          <p class="mt-1.5 text-[0.92rem] text-[color:var(--color-ink-muted)] max-w-xl">
            <Bilingual
              en="Our coordinators are actively engaged in supporting Living Tamil's worldwide literary initiatives, including the upcoming Living Tamil LitFest London 2027."
              ta="எங்கள் ஒருங்கிணைப்பாளர்கள் உலகளாவிய லிவிங் தமிழ் அமைப்பின் செயல்பாடுகளிலும், வரவிருக்கும் லண்டன் லிவிங் தமிழ் லிட்பெஸ்ட் 2027-லும் தீவிரமாகப் பங்காற்றுகிறார்கள்."
            />
          </p>
        </div>
        <a
          href="https://livingtamil.org/people"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary shrink-0 text-center"
        >
          <Bilingual en="View Global Committee ↗" ta="சர்வதேசக் குழுவைக் காண்க ↗" />
        </a>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="border-t border-[color:var(--color-rule)] pt-12 text-center max-w-2xl mx-auto">
      <h2 class="text-[1.5rem] font-medium text-[color:var(--color-ink)]">
        <Bilingual en="Join the Conversation" ta="எங்களுடன் இணையுங்கள்" />
      </h2>
      <p class="mt-3 text-[0.98rem] text-[color:var(--color-ink-muted)]">
        <Bilingual
          en="Interested in joining our fortnightly reading circle, attending workshops, or connecting with us?"
          ta="எங்கள் இருவார வாசிப்பு வட்டத்தில் இணையவோ, பயிலரங்குகளில் பங்கேற்கவோ விரும்புகிறீர்களா?"
        />
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a href="mailto:Vishnupuramlitcircle@gmail.com" class="btn btn-primary">
          <Bilingual en="Email Us" ta="மின்னஞ்சல் அனுப்புக" />
        </a>
        <a href="/contact/" class="btn btn-secondary">
          <Bilingual k="nav.contact" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .activity-bullet {
    color: var(--color-accent);
    font-weight: bold;
    user-select: none;
  }

  .roster-card {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .roster-card:hover {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
  }

  :global(html[data-lang='en']) [data-lang='ta'] {
    display: none !important;
  }

  :global(html[data-lang='ta']) [data-lang='en'] {
    display: none !important;
  }
</style>

